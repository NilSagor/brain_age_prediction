# .coveragerc
[run]
source = src,neurofusion
omit = 
    tests/*
    */__init__.py
    */test_*.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if __name__ == .__main__.:
    raise AssertionError
    raise NotImplementedError
    if 0:
    if False:

[html]
directory = coverage_html